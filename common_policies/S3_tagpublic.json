// tag public=yes
{
    "Version": "2012-10-17",
    "Statement": [
      {
        "Effect": "Allow",
        "Principal": "*",
        "Action": "s3:GetObject",
        "Resource": "arn:aws:s3:::DOC-EXAMPLE-BUCKET/*",
        "Condition": {
          "StringEquals": {
            "s3:ExistingObjectTag/public": "yes"
          }
        }
      }
    ]
  }