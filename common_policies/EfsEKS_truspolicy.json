{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Effect": "Allow",
            "Principal": {
                "Federated": <OIDC-ARN>
                
            },
            "Action": "sts:AssumeRoleWithWebIdentity",
            "Condition": {
                "StringLike": {
                    "oidc.eks.us-east-1.amazonaws.com/id/649536CFF0947E44D457505EBA5D8455:aud": "sts.amazonaws.com",
                    "oidc.eks.us-east-1.amazonaws.com/id/649536CFF0947E44D457505EBA5D8455:sub": "system:serviceaccount:<namespace>:<nameofsa-cancontain*>"
                }
            }
        }
    ]
}